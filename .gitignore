# If you prefer the allow-list style instead, see:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# --- Compiled binaries & libraries -------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib

# --- Build output ------------------------------------------------------------
/bin/
/dist/

# --- Test & coverage artifacts -----------------------------------------------
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# --- Go workspace / vendoring ------------------------------------------------
go.work
go.work.sum
# vendor/            # uncomment if you commit vendored dependencies

# --- Secrets & local environment (NEVER commit) ------------------------------
# .env / .envrc may hold production secrets — keep them out of git. Commit a
# non-secret .env.example instead.
.env
.env.*
!.env.example
.envrc

# --- Node tooling (spec lint via npx, optional) ------------------------------
node_modules/

# --- Claude Code (personal, not shared) --------------------------------------
.claude/settings.local.json

# --- Planning artifacts (BMAD pipeline output — not part of the template) -----
/docs/

# --- Editor / IDE ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS junk -----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db

# --- Logs --------------------------------------------------------------------
*.log
