# .env.example — copy to .env for local development: `cp .env.example .env`
#
# .env is gitignored and MUST NEVER be committed (it may hold real secrets).
# This example carries only non-secret defaults. Every key mirrors
# internal/config/config.go; unset keys fall back to these same defaults.

# --- Runtime -----------------------------------------------------------------
APP_ENV=dev                       # dev | prod (prod puts gin in release mode)
HTTP_PORT=8080                    # 1..65535
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s              # graceful-drain bound (< k8s terminationGracePeriod)
LOG_LEVEL=error                   # debug | info | warn | error (errors-only policy; use debug locally)
MAX_BODY_BYTES=1048576            # request body limit (1 MiB)

# --- Messaging (validated by its factory) ------------------------------------
MESSAGING_DRIVER=memory           # memory | none (none detaches messaging)

# --- Cache (fronts the store; runs ALONGSIDE the DB, never replaces it) -------
CACHE_DRIVER=none                 # none | memory | redis (none = zero overhead)
CACHE_TTL=5m                      # per-entry lifetime
CACHE_REDIS_ADDR=localhost:6379   # Redis-compatible: Redis, Valkey, KeyDB, DragonflyDB
CACHE_REDIS_DB=0                  # logical DB index (0..15)
# CACHE_REDIS_PASSWORD is a SECRET — keep it in your gitignored .env or a
# Kubernetes Secret, never here.
# CACHE_REDIS_PASSWORD=CHANGE_ME

# --- Auth (bearer token on /v1; off by default) ------------------------------
AUTH_ENABLED=false                # true enforces a bearer token on /v1 routes
# AUTH_API_KEYS is a SECRET — keep real keys in your gitignored .env or a
# Kubernetes Secret, never here. Comma-separated bearer keys; required when
# AUTH_ENABLED=true (startup fails otherwise).
# AUTH_API_KEYS=dev-key-1,dev-key-2

# --- Throttle (per-instance in-flight concurrency cap on /v1; off by default)
THROTTLE_ENABLED=false            # true caps concurrent /v1 requests (backpressure, not a rate limit)
THROTTLE_MAX_INFLIGHT=256         # max concurrent /v1 requests when throttling (>=1)

# --- Outbound HTTP client (internal/web/client) -------------------------------
HTTP_CLIENT_TIMEOUT=10s
HTTP_CLIENT_MAX_RETRIES=3         # 1..10 total attempts

# --- OpenTelemetry (vendor-neutral OTLP) -------------------------------------
OTEL_ENABLED=false                # true to export traces + metrics
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=go-template
OTEL_SAMPLE_RATIO=1.0             # 0..1 (lower in prod, e.g. 0.1)

# --- Secrets: DO NOT put real values here --------------------------------
# Real secrets belong in your local .env (gitignored) or, in production, a
# Kubernetes Secret populated by External Secrets Operator — never in git.
# Example placeholder for when the store moves off in-memory:
# DATABASE_URL=postgres://user:CHANGE_ME@localhost:5432/app?sslmode=disable
